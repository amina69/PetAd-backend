<h1 style="font-size:20px;margin:0 0 12px;">{{heading}}</h1>
<p style="font-size:15px;line-height:1.5;margin:0 0 20px;white-space:pre-line;">{{message}}</p>
{{#if actionUrl}}
<p style="margin:0 0 8px;">
  <a href="{{actionUrl}}" style="background:#2563eb;color:#ffffff;text-decoration:none;padding:10px 16px;border-radius:6px;display:inline-block;">
    {{actionLabel}}
  </a>
</p>
{{/if}}
