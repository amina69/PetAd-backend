generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  SHELTER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum DataExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum PetSpecies {
  DOG
  CAT
  BIRD
  RABBIT
  OTHER
}

enum PetStatus {
  AVAILABLE
  PENDING
  IN_CUSTODY
  ADOPTED
}

enum AdoptionStatus {
  REQUESTED
  PENDING
  APPROVED
  ESCROW_FUNDED
  COMPLETED
  REJECTED
  CANCELLED
}

enum CustodyStatus {
  ACTIVE
  RETURNED
  CANCELLED
  VIOLATION
  PENDING
  COMPLETED
}

enum CustodyType {
  OWNER
  TEMPORARY
  SHELTER
}

enum EscrowStatus {
  CREATED
  FUNDED
  RELEASED
  REFUNDED
  DISPUTED
}

enum EventEntityType {
  USER
  PET
  ADOPTION
  CUSTODY
  ESCROW
}

enum EventType {
  USER_REGISTERED
  PET_REGISTERED
  PET_LISTED
  PET_ADOPTED
  PET_CUSTODY_ACTIVE
  PET_RETURNED
  ADOPTION_REQUESTED
  ADOPTION_APPROVED
  ADOPTION_REJECTED
  ADOPTION_CANCELLED
  ADOPTION_COMPLETED
  CUSTODY_CREATED
  CUSTODY_STARTED
  CUSTODY_COMPLETED
  CUSTODY_RETURNED
  PET_CUSTODY_CANCELLED
  CUSTODY_VIOLATION
  CUSTODY_CANCELLED
  CUSTODY_EXTENDED
  ESCROW_CREATED
  ESCROW_FUNDED
  ESCROW_RELEASED
  ESCROW_REFUNDED
  TRUST_SCORE_UPDATED
  USER_SUSPENDED
  USER_REINSTATED
  USER_DELETED
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

enum DocumentKind {
  ID
  PROOF_OF_ADDRESS
  VACCINATION
  EVIDENCE
  MESSAGE_ATTACHMENT
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentEntityType {
  ADOPTION
  CUSTODY
  DISPUTE
  MESSAGE
  HEALTH_RECORD
  PROFILE
  OTHER
}

// ─── Models ──────────────────────────────────────────────

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  // PII columns are nullable so a deleted account can keep its row for
  // referential integrity without retaining personal data.
  password  String?
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  role      UserRole @default(USER)

  status           UserStatus @default(ACTIVE)
  suspendedAt      DateTime?  @map("suspended_at")
  suspensionReason String?    @map("suspension_reason")

  trustScore Float @default(50)

  // Profile fields editable through PATCH /users/:id
  phone    String?
  bio      String?
  location String?

  stellarPublicKey String? @unique @map("stellar_public_key")
  avatarUrl        String? @map("avatar_url")
  avatarPublicId   String? @map("avatar_public_id")

  // Email verification. New accounts start unverified; messaging requires a
  // verified address. Existing accounts were grandfathered by the migration
  // that introduced this column.
  emailVerified              Boolean   @default(false) @map("email_verified")
  emailVerifiedAt            DateTime? @map("email_verified_at")
  emailVerificationTokenHash String?   @unique @map("email_verification_token_hash")
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")

  // Set when the account is soft-deleted and its PII anonymised
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  petsOwned Pet[] @relation("PetOwner")

  adoptionsAsAdopter Adoption[] @relation("Adopter")
  adoptionsAsOwner   Adoption[] @relation("Owner")

  custodiesHeld Custody[] @relation("CustodyHolder")

  events EventLog[] @relation("ActorEvents")

  documents           Document[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]

  conversationsAsParticipantOne Conversation[]            @relation("ConversationParticipantOne")
  conversationsAsParticipantTwo Conversation[]            @relation("ConversationParticipantTwo")
  conversationParticipations    ConversationParticipant[]
  messagesSent                  Message[]                 @relation("SentMessages")
  blocksCreated                 Block[]                   @relation("BlocksCreated")
  blocksReceived                Block[]                   @relation("BlocksReceived")
  reportsFiled                  Report[]                  @relation("ReportsFiled")

  dataExports DataExport[]

  @@index([status])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model Pet {
  id          String     @id @default(uuid())
  name        String
  species     PetSpecies
  status      PetStatus  @default(AVAILABLE)
  breed       String?
  age         Int?
  description String?
  imageUrl    String?    @map("image_url")

  currentOwnerId String? @map("current_owner_id")
  currentOwner   User?   @relation("PetOwner", fields: [currentOwnerId], references: [id])

  // Location of the listing. Coordinates are stored rounded to ~100 m
  // (3 decimal places, see PetsService.roundCoordinate) so an owner's exact
  // address can never be reconstructed from stored data or any API response.
  city      String?
  state     String?
  country   String?
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  adoptions     Adoption[]
  custodies     Custody[]
  conversations Conversation[]

  @@index([species])
  @@index([status])
  @@index([currentOwnerId])
  @@index([latitude, longitude])
  @@map("pets")
}

model Adoption {
  id     String         @id @default(uuid())
  status AdoptionStatus @default(REQUESTED)
  notes  String?

  petId String @map("pet_id")
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  adopterId String @map("adopter_id")
  adopter   User   @relation("Adopter", fields: [adopterId], references: [id])

  ownerId String @map("owner_id")
  owner   User   @relation("Owner", fields: [ownerId], references: [id])

  escrowId String? @unique @map("escrow_id")
  escrow   Escrow? @relation(fields: [escrowId], references: [id])

  documents Document[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([status])
  @@index([adopterId])
  @@index([ownerId])
  @@map("adoptions")
}

model Custody {
  id     String        @id @default(uuid())
  status CustodyStatus @default(ACTIVE)
  type   CustodyType

  depositAmount Decimal? @db.Decimal(12, 2)

  startDate DateTime  @map("start_date")
  endDate   DateTime?

  petId String @map("pet_id")
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  holderId String @map("holder_id")
  holder   User   @relation("CustodyHolder", fields: [holderId], references: [id])

  escrowId String? @unique @map("escrow_id")
  escrow   Escrow? @relation(fields: [escrowId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([holderId])
  @@map("custodies")
}

model Escrow {
  id String @id @default(uuid())

  stellarPublicKey       String @unique @map("stellar_public_key")
  stellarSecretEncrypted String @map("stellar_secret_encrypted")

  assetCode   String  @default("XLM") @map("asset_code")
  assetIssuer String? @map("asset_issuer")

  amount Decimal @db.Decimal(12, 2)

  fundingTxHash String? @map("funding_tx_hash")
  releaseTxHash String? @map("release_tx_hash")
  refundTxHash  String? @map("refund_tx_hash")

  requiredSignatures Int @default(2)

  status EscrowStatus @default(CREATED)

  adoption Adoption?
  custody  Custody?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("escrows")
}

model AppLog {
  id        String   @id @default(uuid())
  level     LogLevel
  action    String
  message   String
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("app_logs")
}

model EventLog {
  id         String          @id @default(uuid())
  entityType EventEntityType @map("entity_type")
  entityId   String          @map("entity_id")
  eventType  EventType       @map("event_type")

  actorId String? @map("actor_id")
  actor   User?   @relation("ActorEvents", fields: [actorId], references: [id])

  txHash      String? @map("tx_hash")
  blockHeight Int?    @map("block_height")

  payload  Json
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([eventType])
  @@index([createdAt])
  @@map("event_logs")
}

model Document {
  id           String @id @default(cuid())
  fileName     String
  fileUrl      String
  publicId     String
  mimeType     String
  size         Int
  uploadedById String

  kind            DocumentKind   @default(OTHER)
  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  sha256          String?
  deletedAt       DateTime?

  // Polymorphic owner: entityType/entityId point at the adoption, custody,
  // dispute, message, health record or profile the document belongs to.
  // entityType is required; adoptionId is kept (nullable) for existing rows
  // and for adoption document queries.
  entityType DocumentEntityType
  entityId   String
  adoptionId String?            @map("adoptionId")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedBy        User               @relation(fields: [uploadedById], references: [id])
  adoption          Adoption?          @relation(fields: [adoptionId], references: [id])
  messageAttachment MessageAttachment?

  @@index([entityType, entityId])
  @@index([uploadedById])
  @@index([adoptionId])
  @@map("documents")
}

model Conversation {
  id               String @id @default(uuid())
  petId            String @map("pet_id")
  participantOneId String @map("participant_one_id")
  participantTwoId String @map("participant_two_id")

  pet            Pet  @relation(fields: [petId], references: [id], onDelete: Cascade)
  participantOne User @relation("ConversationParticipantOne", fields: [participantOneId], references: [id])
  participantTwo User @relation("ConversationParticipantTwo", fields: [participantTwoId], references: [id])

  participants ConversationParticipant[]
  messages     Message[]
  reports      Report[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // participantOneId < participantTwoId (normalised by the service), so the
  // unique key also guarantees one conversation per pet and participant pair.
  @@unique([petId, participantOneId, participantTwoId])
  @@index([participantOneId])
  @@index([participantTwoId])
  @@map("conversations")
}

model ConversationParticipant {
  id                String    @id @default(uuid())
  conversationId    String    @map("conversation_id")
  userId            String    @map("user_id")
  lastReadMessageId String?   @map("last_read_message_id")
  lastReadAt        DateTime? @map("last_read_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  // Plain text only. Messages are never rendered or stored as HTML.
  body           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation("SentMessages", fields: [senderId], references: [id])
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model MessageAttachment {
  id         String   @id @default(uuid())
  messageId  String   @map("message_id")
  documentId String   @unique @map("document_id")
  createdAt  DateTime @default(now()) @map("created_at")

  message  Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlocksCreated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Report {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  reporterId     String   @map("reporter_id")
  reason         String   @db.Text
  details        String?  @db.Text
  // Evidence snapshot taken at creation time. A database trigger rejects any
  // later change to this column.
  snapshot       Json
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reporter     User         @relation("ReportsFiled", fields: [reporterId], references: [id])

  @@index([conversationId])
  @@index([createdAt])
  @@map("reports")
}

model DataExport {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       DataExportStatus @default(PENDING)
  filePath     String?          @map("file_path")
  fileSize     Int?             @map("file_size")
  downloadUrl  String?          @map("download_url")
  expiresAt    DateTime?        @map("expires_at")
  errorMessage String?          @map("error_message")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("data_exports")
}
