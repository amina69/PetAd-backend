generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  SHELTER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum DataExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum PetSpecies {
  DOG
  CAT
  BIRD
  RABBIT
  OTHER
}

enum PetStatus {
  AVAILABLE
  PENDING
  IN_CUSTODY
  ADOPTED
}

enum AdoptionStatus {
  REQUESTED
  PENDING
  APPROVED
  ESCROW_FUNDED
  COMPLETED
  REJECTED
  CANCELLED
}

enum CustodyStatus {
  ACTIVE
  RETURNED
  CANCELLED
  VIOLATION
  PENDING
  COMPLETED
}

enum CustodyType {
  OWNER
  TEMPORARY
  SHELTER
}

enum EscrowStatus {
  CREATED
  FUNDED
  RELEASED
  REFUNDED
  DISPUTED
}

enum EventEntityType {
  USER
  PET
  ADOPTION
  CUSTODY
  ESCROW
  REVIEW
}

enum EventType {
  USER_REGISTERED
  PET_REGISTERED
  PET_LISTED
  PET_ADOPTED
  PET_CUSTODY_ACTIVE
  PET_RETURNED
  ADOPTION_REQUESTED
  ADOPTION_APPROVED
  ADOPTION_REJECTED
  ADOPTION_CANCELLED
  ADOPTION_COMPLETED
  CUSTODY_CREATED
  CUSTODY_STARTED
  CUSTODY_COMPLETED
  CUSTODY_RETURNED
  PET_CUSTODY_CANCELLED
  CUSTODY_VIOLATION
  CUSTODY_CANCELLED
  CUSTODY_EXTENDED
  ESCROW_CREATED
  ESCROW_FUNDED
  ESCROW_RELEASED
  ESCROW_REFUNDED
  DISPUTE_OPENED
  DISPUTE_RESOLVED_IN_FAVOUR
  DISPUTE_RESOLVED_AGAINST
  DOCUMENT_VERIFIED
  REVIEW_CREATED
  TRUST_SCORE_UPDATED
  USER_SUSPENDED
  USER_REINSTATED
  USER_DELETED
}

enum TrustEventType {
  AGREEMENT_COMPLETED
  POSITIVE_REVIEW
  NEUTRAL_REVIEW
  NEGATIVE_REVIEW
  DISPUTE_OPENED
  DISPUTE_RESOLVED_IN_FAVOUR
  DISPUTE_RESOLVED_AGAINST
  VIOLATION
  DOCUMENT_VERIFIED
}

enum ReviewAgreementType {
  ADOPTION
  CUSTODY
}

enum ReviewReportReason {
  SPAM
  ABUSE
  OFFENSIVE
  IRRELEVANT
  OTHER
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

// ─── Models ──────────────────────────────────────────────

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  // PII columns are nullable so a deleted account can keep its row for
  // referential integrity without retaining personal data.
  password  String?
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  role      UserRole @default(USER)

  status           UserStatus @default(ACTIVE)
  suspendedAt      DateTime?  @map("suspended_at")
  suspensionReason String?    @map("suspension_reason")

  trustScore Float @default(50)

  // Profile fields editable through PATCH /users/:id
  phone    String?
  bio      String?
  location String?

  stellarPublicKey String? @unique @map("stellar_public_key")
  avatarUrl        String? @map("avatar_url")
  avatarPublicId   String? @map("avatar_public_id")

  // Set when the account is soft-deleted and its PII anonymised
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  petsOwned Pet[] @relation("PetOwner")

  adoptionsAsAdopter Adoption[] @relation("Adopter")
  adoptionsAsOwner   Adoption[] @relation("Owner")

  custodiesHeld Custody[] @relation("CustodyHolder")

  events EventLog[] @relation("ActorEvents")

  documents           Document[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]

  dataExports DataExport[]

  trustScoreSnapshot TrustScore?
  trustEvents        TrustEvent[]     @relation("TrustEventSubjects")
  reviewsWritten     Review[]         @relation("ReviewsWritten")
  reviewsReceived    Review[]         @relation("ReviewsReceived")
  reviewResponses    ReviewResponse[] @relation("ReviewResponses")
  reviewReports      ReviewReport[]   @relation("ReviewReports")

  @@index([status])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model Pet {
  id          String     @id @default(uuid())
  name        String
  species     PetSpecies
  status      PetStatus  @default(AVAILABLE)
  breed       String?
  age         Int?
  description String?
  imageUrl    String?    @map("image_url")

  currentOwnerId String? @map("current_owner_id")
  currentOwner   User?   @relation("PetOwner", fields: [currentOwnerId], references: [id])

  // Location of the listing. Coordinates are stored rounded to ~100 m
  // (3 decimal places, see PetsService.roundCoordinate) so an owner's exact
  // address can never be reconstructed from stored data or any API response.
  city      String?
  state     String?
  country   String?
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  adoptions Adoption[]
  custodies Custody[]

  @@index([species])
  @@index([status])
  @@index([currentOwnerId])
  @@index([latitude, longitude])
  @@map("pets")
}

model Adoption {
  id     String         @id @default(uuid())
  status AdoptionStatus @default(REQUESTED)
  notes  String?

  petId String @map("pet_id")
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  adopterId String @map("adopter_id")
  adopter   User   @relation("Adopter", fields: [adopterId], references: [id])

  ownerId String @map("owner_id")
  owner   User   @relation("Owner", fields: [ownerId], references: [id])

  escrowId String? @unique @map("escrow_id")
  escrow   Escrow? @relation(fields: [escrowId], references: [id])

  documents Document[]
  reviews   Review[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@index([status])
  @@index([adopterId])
  @@index([ownerId])
  @@map("adoptions")
}

model Custody {
  id     String        @id @default(uuid())
  status CustodyStatus @default(ACTIVE)
  type   CustodyType

  depositAmount Decimal? @db.Decimal(12, 2)

  startDate DateTime  @map("start_date")
  endDate   DateTime?

  petId String @map("pet_id")
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  holderId String @map("holder_id")
  holder   User   @relation("CustodyHolder", fields: [holderId], references: [id])

  escrowId String? @unique @map("escrow_id")
  escrow   Escrow? @relation(fields: [escrowId], references: [id])

  reviews Review[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([holderId])
  @@map("custodies")
}

model Escrow {
  id String @id @default(uuid())

  stellarPublicKey       String @unique @map("stellar_public_key")
  stellarSecretEncrypted String @map("stellar_secret_encrypted")

  assetCode   String  @default("XLM") @map("asset_code")
  assetIssuer String? @map("asset_issuer")

  amount Decimal @db.Decimal(12, 2)

  fundingTxHash String? @map("funding_tx_hash")
  releaseTxHash String? @map("release_tx_hash")
  refundTxHash  String? @map("refund_tx_hash")

  requiredSignatures Int @default(2)

  status EscrowStatus @default(CREATED)

  adoption Adoption?
  custody  Custody?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("escrows")
}

model AppLog {
  id        String   @id @default(uuid())
  level     LogLevel
  action    String
  message   String
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("app_logs")
}

model EventLog {
  id         String          @id @default(uuid())
  entityType EventEntityType @map("entity_type")
  entityId   String          @map("entity_id")
  eventType  EventType       @map("event_type")

  actorId String? @map("actor_id")
  actor   User?   @relation("ActorEvents", fields: [actorId], references: [id])

  txHash      String? @map("tx_hash")
  blockHeight Int?    @map("block_height")

  payload  Json
  metadata Json?

  trustSources TrustEventSource[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([eventType])
  @@index([createdAt])
  @@map("event_logs")
}

model Document {
  id           String   @id @default(cuid())
  fileName     String
  fileUrl      String
  publicId     String
  mimeType     String
  size         Int
  uploadedById String
  adoptionId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy User     @relation(fields: [uploadedById], references: [id])
  adoption   Adoption @relation(fields: [adoptionId], references: [id])

  @@map("documents")
}

model DataExport {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       DataExportStatus @default(PENDING)
  filePath     String?          @map("file_path")
  fileSize     Int?             @map("file_size")
  downloadUrl  String?          @map("download_url")
  expiresAt    DateTime?        @map("expires_at")
  errorMessage String?          @map("error_message")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("data_exports")
}

model TrustEventSource {
  sourceEventId String   @id @map("source_event_id")
  event         EventLog @relation(fields: [sourceEventId], references: [id], onDelete: Cascade)
  processedAt   DateTime @default(now()) @map("processed_at")

  trustEvents TrustEvent[]

  @@index([processedAt])
  @@map("trust_event_sources")
}

model TrustEvent {
  id            String           @id @default(uuid())
  sourceEventId String           @map("source_event_id")
  source        TrustEventSource @relation(fields: [sourceEventId], references: [sourceEventId], onDelete: Cascade)

  subjectUserId String @map("subject_user_id")
  subject       User   @relation("TrustEventSubjects", fields: [subjectUserId], references: [id], onDelete: Cascade)

  type       TrustEventType
  occurredAt DateTime       @map("occurred_at")
  weight     Float          @default(1)
  payload    Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([sourceEventId, subjectUserId, type])
  @@index([subjectUserId, occurredAt])
  @@index([type])
  @@map("trust_events")
}

model TrustScore {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  score            Float
  band             String
  algorithmVersion String @map("algorithm_version")
  factors          Json
  eventCount       Int    @default(0) @map("event_count")

  completedAgreements      Int @default(0) @map("completed_agreements")
  disputesTotal            Int @default(0) @map("disputes_total")
  disputesResolvedInFavour Int @default(0) @map("disputes_resolved_in_favour")

  anchoredThrough String?  @map("anchored_through")
  calculatedAt    DateTime @map("calculated_at")

  @@index([score])
  @@index([algorithmVersion])
  @@map("trust_scores")
}

model Review {
  id String @id @default(uuid())

  rating Int
  title  String
  body   String

  reviewerId String @map("reviewer_id")
  reviewer   User   @relation("ReviewsWritten", fields: [reviewerId], references: [id])

  subjectId String @map("subject_id")
  subject   User   @relation("ReviewsReceived", fields: [subjectId], references: [id])

  agreementType ReviewAgreementType @map("agreement_type")
  adoptionId    String?             @map("adoption_id")
  custodyId     String?             @map("custody_id")
  adoption      Adoption?           @relation(fields: [adoptionId], references: [id], onDelete: Cascade)
  custody       Custody?            @relation(fields: [custodyId], references: [id], onDelete: Cascade)

  response ReviewResponse?
  reports  ReviewReport[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([subjectId, createdAt])
  @@index([reviewerId])
  @@index([adoptionId])
  @@index([custodyId])
  @@map("reviews")
}

model ReviewResponse {
  id String @id @default(uuid())

  reviewId String @unique @map("review_id")
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  responderId String @map("responder_id")
  responder   User   @relation("ReviewResponses", fields: [responderId], references: [id])

  body String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([responderId])
  @@map("review_responses")
}

model ReviewReport {
  id String @id @default(uuid())

  reviewId String @map("review_id")
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  reporterId String @map("reporter_id")
  reporter   User   @relation("ReviewReports", fields: [reporterId], references: [id])

  reason  ReviewReportReason
  details String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([reviewId, reporterId])
  @@index([reason])
  @@map("review_reports")
}
