generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  SHELTER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum DataExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum PetSpecies {
  DOG
  CAT
  BIRD
  RABBIT
  OTHER
}

enum PetStatus {
  AVAILABLE
  PENDING
  IN_CUSTODY
  ADOPTED
}

enum AdoptionStatus {
  REQUESTED
  PENDING
  APPROVED
  ESCROW_FUNDED
  COMPLETED
  REJECTED
  CANCELLED
}

enum CustodyStatus {
  ACTIVE
  RETURNED
  CANCELLED
  VIOLATION
  PENDING
  COMPLETED
}

enum CustodyType {
  OWNER
  TEMPORARY
  SHELTER
}

enum EscrowStatus {
  CREATED
  FUNDED
  RELEASED
  REFUNDED
  DISPUTED
}

enum EventEntityType {
  USER
  PET
  ADOPTION
  CUSTODY
  ESCROW
  PAYMENT
  REVIEW
  BADGE
}

enum EventType {
  USER_REGISTERED
  PET_REGISTERED
  PET_LISTED
  PET_ADOPTED
  PET_CUSTODY_ACTIVE
  PET_RETURNED
  ADOPTION_REQUESTED
  ADOPTION_APPROVED
  ADOPTION_REJECTED
  ADOPTION_CANCELLED
  ADOPTION_COMPLETED
  CUSTODY_CREATED
  CUSTODY_STARTED
  CUSTODY_COMPLETED
  CUSTODY_RETURNED
  PET_CUSTODY_CANCELLED
  CUSTODY_VIOLATION
  CUSTODY_CANCELLED
  CUSTODY_EXTENDED
  ESCROW_CREATED
  ESCROW_FUNDED
  ESCROW_RELEASED
  ESCROW_REFUNDED
  TRUST_SCORE_UPDATED
  USER_SUSPENDED
  USER_REINSTATED
  USER_DELETED
  PAYMENT_REFUNDED
  REFUND_REQUESTED
  REFUND_APPROVED
  REFUND_DENIED
  REVIEW_REPORTED
  REVIEW_HIDDEN
  REVIEW_RESTORED
  REVIEW_DELETED
  RATING_SUMMARY_UPDATED
  BADGE_AWARDED
  BADGE_REVOKED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentLineKind {
  ESCROW_FUNDED
  SERVICE_FEE
  DEPOSIT
  PAYOUT
  ADJUSTMENT
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  PARTIALLY_APPROVED
  DENIED
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum ReviewReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum BadgeCode {
  ID_VERIFIED
  TRUSTED_ADOPTER
  VERIFIED_SHELTER
  CLEAN_RECORD_12M
}

enum UserBadgeStatus {
  AWARDED
  REVOKED
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

// ─── Models ──────────────────────────────────────────────

model Session {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  familyId    String
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  // PII columns are nullable so a deleted account can keep its row for
  // referential integrity without retaining personal data.
  password  String?
  firstName String?    @map("first_name")
  lastName  String?    @map("last_name")
  role      UserRole   @default(USER)

  status           UserStatus @default(ACTIVE)
  suspendedAt      DateTime?  @map("suspended_at")
  suspensionReason String?    @map("suspension_reason")

  trustScore Float   @default(50)

  // Persisted aggregate of visible reviews. Recomputed by the review
  // moderation flow so hidden reviews never count towards the public rating.
  ratingAverage Float? @map("rating_average")
  ratingCount   Int    @default(0) @map("rating_count")

  // Profile fields editable through PATCH /users/:id
  phone    String?
  bio      String?
  location String?

  stellarPublicKey String?   @unique @map("stellar_public_key")
  avatarUrl        String?   @map("avatar_url")
  avatarPublicId   String?   @map("avatar_public_id")

  // Set when the account is soft-deleted and its PII anonymised
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  petsOwned   Pet[] @relation("PetOwner")

  adoptionsAsAdopter Adoption[] @relation("Adopter")
  adoptionsAsOwner   Adoption[] @relation("Owner")

  custodiesHeld Custody[] @relation("CustodyHolder")

  events EventLog[] @relation("ActorEvents")

  documents Document[]
  passwordResetTokens PasswordResetToken[]
  sessions    Session[]

  dataExports DataExport[]

  paymentsMade     Payment[]       @relation("PaymentPayer")
  paymentsReceived Payment[]       @relation("PaymentPayee")
  refundRequests   RefundRequest[] @relation("RefundRequester")
  refundDecisions  RefundRequest[] @relation("RefundDecider")

  reviewsWritten   Review[] @relation("ReviewAuthor")
  reviewsReceived  Review[] @relation("ReviewSubject")
  moderatedReviews Review[] @relation("ReviewModerator")
  reviewReports    ReviewReport[] @relation("ReviewReporter")
  resolvedReports  ReviewReport[] @relation("ReviewReportResolver")

  badges UserBadge[]

  @@index([status])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model Pet {
  id          String      @id @default(uuid())
  name        String
  species     PetSpecies
  status      PetStatus   @default(AVAILABLE)
  breed       String?
  age         Int?
  description String?
  imageUrl    String?     @map("image_url")

  currentOwnerId String?  @map("current_owner_id")
  currentOwner   User?    @relation("PetOwner", fields: [currentOwnerId], references: [id])

  // Location of the listing. Coordinates are stored rounded to ~100 m
  // (3 decimal places, see PetsService.roundCoordinate) so an owner's exact
  // address can never be reconstructed from stored data or any API response.
  city      String?
  state     String?
  country   String?
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  adoptions Adoption[]
  custodies Custody[]

  @@index([species])
  @@index([status])
  @@index([currentOwnerId])
  @@index([latitude, longitude])
  @@map("pets")
}

model Adoption {
  id     String         @id @default(uuid())
  status AdoptionStatus @default(REQUESTED)
  notes  String?

  petId String @map("pet_id")
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  adopterId String @map("adopter_id")
  adopter   User   @relation("Adopter", fields: [adopterId], references: [id])

  ownerId String @map("owner_id")
  owner   User   @relation("Owner", fields: [ownerId], references: [id])

  escrowId String?  @unique @map("escrow_id")
  escrow   Escrow? @relation(fields: [escrowId], references: [id])
  
  documents Document[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([adopterId])
  @@index([ownerId])
  @@map("adoptions")
}

model Custody {
  id       String        @id @default(uuid())
  status   CustodyStatus @default(ACTIVE)
  type     CustodyType

  depositAmount Decimal? @db.Decimal(12, 2)

  startDate DateTime @map("start_date")
  endDate   DateTime?

  petId String @map("pet_id")
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  holderId String @map("holder_id")
  holder   User   @relation("CustodyHolder", fields: [holderId], references: [id])

  escrowId String? @unique @map("escrow_id")
  escrow   Escrow? @relation(fields: [escrowId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([holderId])
  @@map("custodies")
}

model Escrow {
  id String @id @default(uuid())

  stellarPublicKey String @unique @map("stellar_public_key")
  stellarSecretEncrypted String @map("stellar_secret_encrypted")

  assetCode String @default("XLM") @map("asset_code")
  assetIssuer String? @map("asset_issuer")

  amount Decimal @db.Decimal(12, 2)

  fundingTxHash  String? @map("funding_tx_hash")
  releaseTxHash  String? @map("release_tx_hash")
  refundTxHash   String? @map("refund_tx_hash")

  requiredSignatures Int @default(2)

  status EscrowStatus @default(CREATED)

  adoption Adoption?
  custody  Custody?
  payment  Payment?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("escrows")
}

model Payment {
  id String @id @default(uuid())

  payerId String @map("payer_id")
  payer   User   @relation("PaymentPayer", fields: [payerId], references: [id])

  payeeId String? @map("payee_id")
  payee   User?   @relation("PaymentPayee", fields: [payeeId], references: [id])

  // Money is always stored and returned as an integer amount in minor units
  // together with its currency, matching the frontend `Money` type.
  amountMinor         Int    @map("amount_minor")
  refundedAmountMinor Int    @default(0) @map("refunded_amount_minor")
  currency            String @default("XLM")

  status PaymentStatus @default(PENDING)

  // Settlement escrow backing the payment when it funds an adoption or
  // custody agreement. Also resolves the related entity link.
  escrowId String? @unique @map("escrow_id")
  escrow   Escrow? @relation(fields: [escrowId], references: [id])

  paidAt DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines          PaymentLine[]
  refundRequests RefundRequest[]

  @@index([payerId, createdAt])
  @@index([payeeId])
  @@index([status])
  @@map("payments")
}

model PaymentLine {
  id          String          @id @default(uuid())
  paymentId   String          @map("payment_id")
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  kind        PaymentLineKind
  label       String
  amountMinor Int             @map("amount_minor")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([paymentId])
  @@map("payment_lines")
}

model RefundRequest {
  id        String  @id @default(uuid())
  paymentId String  @map("payment_id")
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  requesterId String @map("requester_id")
  requester   User   @relation("RefundRequester", fields: [requesterId], references: [id])

  reason               String
  requestedAmountMinor Int?                  @map("requested_amount_minor")
  approvedAmountMinor  Int?                  @map("approved_amount_minor")
  status               RefundRequestStatus   @default(PENDING)

  decidedById    String?   @map("decided_by_id")
  decidedBy      User?     @relation("RefundDecider", fields: [decidedById], references: [id])
  decisionReason String?   @map("decision_reason")
  decidedAt      DateTime? @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([paymentId])
  @@index([status, createdAt])
  @@map("refund_requests")
}

model Review {
  id String @id @default(uuid())

  authorId String @map("author_id")
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id])

  subjectId String @map("subject_id")
  subject   User   @relation("ReviewSubject", fields: [subjectId], references: [id])

  // Agreement the review refers to (ADOPTION or CUSTODY).
  agreementType String? @map("agreement_type")
  agreementId   String? @map("agreement_id")

  rating  Int
  comment String?

  status ReviewStatus @default(VISIBLE)

  moderationReason String?   @map("moderation_reason")
  moderatedById    String?   @map("moderated_by_id")
  moderatedBy      User?     @relation("ReviewModerator", fields: [moderatedById], references: [id])
  moderatedAt      DateTime? @map("moderated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reports ReviewReport[]

  @@index([subjectId, status])
  @@index([authorId])
  @@index([status, createdAt])
  @@map("reviews")
}

model ReviewReport {
  id       String @id @default(uuid())
  reviewId String @map("review_id")
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  reporterId String @map("reporter_id")
  reporter   User   @relation("ReviewReporter", fields: [reporterId], references: [id])

  reason String
  status ReviewReportStatus @default(OPEN)

  resolvedById   String?   @map("resolved_by_id")
  resolvedBy     User?     @relation("ReviewReportResolver", fields: [resolvedById], references: [id])
  resolutionNote String?   @map("resolution_note")
  resolvedAt     DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([reviewId, reporterId])
  @@index([status, createdAt])
  @@map("review_reports")
}

model BadgeDefinition {
  id          String    @id @default(uuid())
  code        BadgeCode @unique
  name        String
  description String
  criteria    Json?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  userBadges UserBadge[]

  @@map("badge_definitions")
}

model UserBadge {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  definitionId String          @map("definition_id")
  definition   BadgeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  status UserBadgeStatus @default(AWARDED)

  // Event ledger ids proving the award. Kept as a plain string array so a
  // badge stays auditable even as the ledger grows independently.
  supportingEventIds String[] @map("supporting_event_ids")
  reason             String?

  awardedAt DateTime  @default(now()) @map("awarded_at")
  revokedAt DateTime? @map("revoked_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([userId, definitionId])
  @@index([userId, status])
  @@map("user_badges")
}

model AppLog {
  id        String   @id @default(uuid())
  level     LogLevel
  action    String
  message   String
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("app_logs")
}

model EventLog {
  id          String           @id @default(uuid())
  entityType  EventEntityType  @map("entity_type")
  entityId    String           @map("entity_id")
  eventType   EventType        @map("event_type")

  actorId String? @map("actor_id")
  actor   User?   @relation("ActorEvents", fields: [actorId], references: [id])

  txHash      String? @map("tx_hash")
  blockHeight Int?    @map("block_height")

  payload  Json
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([eventType])
  @@index([createdAt])
  @@map("event_logs")
}

model Document {
  id           String   @id @default(cuid())
  fileName     String
  fileUrl      String
  publicId     String
  mimeType     String
  size         Int
  uploadedById String
  adoptionId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  adoption     Adoption @relation(fields: [adoptionId], references: [id])

  @@map("documents")
}

model DataExport {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       DataExportStatus @default(PENDING)
  filePath     String?          @map("file_path")
  fileSize     Int?             @map("file_size")
  downloadUrl  String?          @map("download_url")
  expiresAt    DateTime?        @map("expires_at")
  errorMessage String?          @map("error_message")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("data_exports")
}
