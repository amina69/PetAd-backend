# ─── Application ──────────────────────────────────────────
PORT=3000
NODE_ENV=development          # development | production | test
API_PREFIX=api/v1
LOG_LEVEL=info                # debug | info | warn | error

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://petad:petadpassword@localhost:5432/petad_db

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Authentication ───────────────────────────────────────
# Must be at least 32 characters. Keep this secret.
JWT_SECRET=your-super-secure-jwt-secret-min-32-characters
JWT_EXPIRATION=7d

# ─── Stellar Blockchain (conditional) ─────────────────────
# Set STELLAR_ENABLED=true to require the variables below.
STELLAR_ENABLED=false
STELLAR_NETWORK=testnet       # testnet | mainnet | futurenet
STELLAR_SECRET_KEY=S...
STELLAR_PUBLIC_KEY=G...
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# ─── Email (Optional) ─────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PetAd <no-reply@petad.local>

# ─── File Upload ──────────────────────────────────────────
MAX_FILE_SIZE=10485760        # 10MB in bytes
UPLOAD_DEST=./uploads

# ─── Background Jobs ──────────────────────────────────────
QUEUE_CONCURRENCY=5
JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY=5000

# ─── Security ─────────────────────────────────────────────
# Comma-separated allowlist (e.g. http://localhost:3000,http://localhost:5173).
# Leave empty to reject all browser origins by default.
CORS_ENABLED=true
CORS_CREDENTIALS=true
CORS_ORIGINS=

# Max request body size (e.g. 100kb, 1mb, 10mb)
MAX_BODY_SIZE=100kb

# Trust proxy (e.g. when behind a reverse/load balancer)
TRUST_PROXY=false

# ─── Monitoring (Optional) ────────────────────────────────
SENTRY_DSN=

# ─── Versioned fees & reports ─────────────────────────────
# Cache lifetime for the effective fee schedule.
FEE_SCHEDULE_CACHE_TTL_SECONDS=60
# Ranges longer than this are generated by an async job.
REVENUE_REPORT_SYNC_LIMIT_DAYS=366

# ─── Inbound webhooks ─────────────────────────────────────
# Comma-separated provider names. Each listed provider requires a
# WEBHOOK_<PROVIDER>_SECRET (optionally _SIGNATURE_HEADER / _EVENT_ID_HEADER).
WEBHOOK_PROVIDERS=
# WEBHOOK_STRIPE_SECRET=whsec_...
# WEBHOOK_STELLAR_SECRET=...
WEBHOOK_TOLERANCE_SECONDS=300

# ─── Trust anti-abuse ─────────────────────────────────────
TRUST_ABUSE_MIN_ACCOUNT_AGE_DAYS=30
TRUST_ABUSE_REVIEW_BURST_WINDOW_DAYS=7
TRUST_ABUSE_REVIEW_BURST_THRESHOLD=5
TRUST_ABUSE_AGREEMENT_THRESHOLD=3
TRUST_ABUSE_FLAGGED_WEIGHT=0.2
TRUST_ABUSE_SIGNAL_SALT=change-me-in-production
